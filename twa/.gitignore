# Keystore — NEVER commit. Losing it = every existing TWA install
# becomes orphaned (Android keys app identity to the signing cert).
# Back up to 1Password + offline storage before first signed build.
*.keystore
*.jks
keystore.properties
signing-key-info.json

# Build outputs
*.aab
*.apk
app-release*
app-debug*
output-metadata.json

# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/

# Node (Bubblewrap CLI if installed locally instead of globally)
node_modules/

# Bubblewrap working state
.bubblewrap/

# OS
.DS_Store
Thumbs.db
